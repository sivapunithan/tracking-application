<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/w_plan_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/w_plan_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/widget_plan_empty" android:textColor="#E6FFFFFF" android:textSize="13sp" />
    <TextView android:id="@+id/w_line1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/w_line2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/w_line3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
