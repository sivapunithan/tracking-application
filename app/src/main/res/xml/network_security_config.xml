<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is never allowed. The only code that opens connections is HttpFeedSource (host allow-list from feeds.json). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
