<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- The ONLY permission. Used solely by the optional "Latest headlines" feature (HttpFeedSource);
         it can be switched off in Settings, and all traffic is https to the hosts listed in assets/feeds.json. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional step counter: only asked for after a plain explanation screen; the app works without it. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Optional evening wrap-up reminder (OFF by default): asked for only when she switches the reminder on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Optional phone-usage view: she switches "Usage access" on in system settings; read only on app open, kept on this phone. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Lets us read the NAMES of apps that have a home-screen icon (and nothing else). We do NOT request QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".TnpscApp"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TnpscPrep">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mathi.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".reminder.ReminderReceiver" android:exported="false" />

        <!-- Persists the in-app language on Android 8-12 (API < 33 has no system store for per-app locales). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
